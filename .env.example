SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# Deployment domain(s) — comma-separated for multiple hosts
# Local: ALLOWED_HOSTS=localhost,127.0.0.1
# Production: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins — only set in production if using subdomain(s)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com

# Move the admin off the well-known /admin/ path in production (optional,
# but recommended — reduces automated brute-force/scanning noise)
# ADMIN_URL=staff-portal-x7k2/

# Log level for the app and Django's own loggers (DEBUG/INFO/WARNING/ERROR)
# LOG_LEVEL=INFO

# Site URL for password reset emails and absolute links (must include protocol and domain)
# REQUIRED in production. Local dev defaults to http://127.0.0.1:8000
# Example: SITE_URL=https://yourdomain.com
# SITE_URL=http://127.0.0.1:8000

# CSV Product Import Notes:
# - Variant format: size-color-sku-adjustment-stock (SKU can contain hyphens)
#   Example: M-Blue-TSHIRT-BLK-M-0-50 creates variant M/Blue with SKU "TSHIRT-BLK-M"
# - Image URLs must start with http:// or https:// (requires Cloudinary storage for remote images)

# Neon/PostgreSQL production database URL
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Cloudinary product-image storage
# Get from https://cloudinary.com/ and format as:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Enable "Strict transformations" in Security Settings (prevents abuse)

# Razorpay test/production keys (keep secure — never commit)
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret (set via Razorpay dashboard)
RAZORPAY_CURRENCY=INR

# Payment & Cart Configuration
# Minutes to hold inventory when payment is initiated (prevents abandonment recovery)
PAYMENT_RESERVATION_MINUTES=30
# Tax rate as decimal (0.0 = 0%, 0.18 = 18%)
TAX_RATE=0

# Security: Rate Limiting
# When True in production, uses Cloudflare's True-Client-IP header for rate limiting
# (prevents shared-IP false-positives when behind Cloudflare)
# TRUST_TRUE_CLIENT_IP=True

# Email delivery for OTP and order notifications.
# Production default is Brevo's HTTP API (via django-anymail), NOT SMTP:
# Render blocks outbound traffic on SMTP ports 25/465/587 for free web
# services, so smtplib connections (Gmail included) get severed mid-handshake
# there. Get a free Brevo account + v3 API key at https://www.brevo.com,
# verify a sender address (just a 6-digit email confirmation, no DNS needed),
# and set BREVO_API_KEY below. DEFAULT_FROM_EMAIL must match a Brevo-verified
# sender.
DEFAULT_FROM_EMAIL=IKart <your-email@example.com>
BREVO_API_KEY=your-brevo-v3-api-key

# Only needed if EMAIL_BACKEND is overridden to use SMTP instead (e.g. when
# deploying somewhere that doesn't block SMTP ports).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-app-password

# Lux AI Shopping Assistant Configuration
# Supports multiple providers: groq (default), claude, openai, ollama
# Switch providers by changing AI_PROVIDER (no code changes needed!)
AI_PROVIDER=groq

# Groq API key (free tier; get from https://console.groq.com/)
# Required if AI_PROVIDER=groq
GROQ_API_KEY=gsk-your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b

# Claude API key (get from https://console.anthropic.com/api/keys)
# Required if AI_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-your-claude-api-key
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenAI API key (optional, for future use)
# OPENAI_API_KEY=sk-your-openai-api-key

# Ollama base URL (optional, for local self-hosted LLM)
# OLLAMA_BASE_URL=http://localhost:11434
