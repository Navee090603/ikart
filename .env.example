SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# Deployment domain(s) — comma-separated for multiple hosts
# Local: ALLOWED_HOSTS=localhost,127.0.0.1
# Production: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins — only set in production if using subdomain(s)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com

# Site URL for password reset emails and absolute links (must include protocol and domain)
# Local: SITE_URL=http://127.0.0.1:8000
# Production: SITE_URL=https://yourdomain.com
SITE_URL=http://127.0.0.1:8000

# Neon/PostgreSQL production database URL
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Cloudinary product-image storage
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Razorpay test/production keys (keep secure — never commit)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
PAYMENT_RESERVATION_MINUTES=30
TAX_RATE=0

# SMTP email delivery for OTP and order notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=IKart <your-email@example.com>
