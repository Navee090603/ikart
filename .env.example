SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Neon production database URL
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Cloudinary product-image storage
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Razorpay test/production keys. Keep these only in .env / Render environment variables.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
PAYMENT_RESERVATION_MINUTES=30
TAX_RATE=0
# Background tasks (Celery + Redis)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=
# True runs tasks inline without a worker; set False once a worker and Redis are running.
CELERY_TASK_ALWAYS_EAGER=True
CELERY_WORKER_CONCURRENCY=4
PAYMENT_SWEEP_CRON_MINUTES=15
# SMTP email delivery for production OTP and order emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=IKart <your-email@example.com>
